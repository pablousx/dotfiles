default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"
    name[Group1] = "English (US, Spanish AltGr layer)";

    key <AE01> { [ 1, exclam, exclamdown, exclamdown ] };
    key <AE05> { [ 5, percent, EuroSign, EuroSign ] };
    key <AE10> { [ 0, parenright, degree, degree ] };
    key <AE11> { [ minus, underscore, emdash, emdash ] };

    key <AD03> { [ e, E, eacute, Eacute ] };
    key <AD06> { [ y, Y, udiaeresis, Udiaeresis ] };
    key <AD07> { [ u, U, uacute, Uacute ] };
    key <AD08> { [ i, I, iacute, Iacute ] };
    key <AD09> { [ o, O, oacute, Oacute ] };
    key <AD11> { [ bracketleft, braceleft, guillemotleft, guillemotleft ] };
    key <AD12> { [ bracketright, braceright, guillemotright, guillemotright ] };

    key <AC01> { [ a, A, aacute, Aacute ] };
    key <AB06> { [ n, N, ntilde, Ntilde ] };
    key <AB10> { [ slash, question, questiondown, questiondown ] };

    include "level3(ralt_switch)"
};
