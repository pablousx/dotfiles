# Portable aliases that do not depend on the local dotfiles checkout.
alias ni='npm install'
alias nd='npm run dev'
alias nb='npm run build'
alias ns='npm run start'

alias pni='pnpm install'
alias pnd='pnpm run dev'
alias pnb='pnpm run build'
alias pns='pnpm run start'

alias yi='yarn install'
alias yd='yarn dev'
alias yb='yarn build'
alias ys='yarn start'

alias cx='cd ..'
alias cz='cd -'
alias reload='exec zsh'

alias -g G='| grep'
alias -g H='| head'
alias -g L='| less'
alias -g S='| sort'
alias -g T='| tail'
alias -g X='| xargs'
